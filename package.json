{
  "name": "local-rag-help-demo",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "maven": "node scripts/run-maven.mjs",
    "dev": "pnpm build:server && concurrently --kill-others --names JAVA,WEB \"java -jar target/ragbot.jar --server.port=3001\" \"vite\"",
    "build:index": "pnpm build:server && java -jar target/ragbot.jar --spring.main.web-application-type=none --rag.build-index=true",
    "build:server": "node scripts/run-maven.mjs --batch-mode package",
    "build": "vite build && pnpm build:server",
    "build:all": "pnpm run build:index && pnpm run build",
    "server": "pnpm build:server && java -jar target/ragbot.jar",
    "server:dev": "pnpm build:server && java -jar target/ragbot.jar --server.port=3001",
    "start": "java -jar target/ragbot.jar",
    "test:server": "node scripts/run-maven.mjs --batch-mode test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
